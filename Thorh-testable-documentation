class User(UserMixin, db.Model):
    id = db.Column(db.String(100), primary_key=True)
    username = db.Column(db.String(80), unique=True, nullable=False)
    password_hash = db.Column(db.String(120), nullable=False)

@login_manager.user_loader
def load_user(user_id):
    return User.query.get(user_id)

# --- Enhanced Models ---
class Assistant(db.Model):
    id = db.Column(db.String(100), primary_key=True)
    type = db.Column(db.String(50), nullable=False)
    name = db.Column(db.String(100), nullable=False)
    model = db.Column(db.String(100), nullable=False)
    api_key_encrypted = db.Column(db.Text, nullable=True)
    active = db.Column(db.Boolean, default=True)
    is_critic = db.Column(db.Boolean, default=False)
    created_at = db.Column(db.DateTime, default=db.func.current_timestamp())
    
    def to_dict(self):
        return {
            'id': self.id,
            'type': self.type,
            'name': self.name,
            'model': self.model,
            'active': self.active,
            'is_critic': self.is_critic,
            'created_at': self.created_at.isoformat()
        }

class Message(db.Model):
    id = db.Column(db.Integer, primary_key=True)
    timestamp = db.Column(db.DateTime, default=db.func.current_timestamp(), index=True)
    sender_id = db.Column(db.String(100), nullable=False)
    sender_type = db.Column(db.String(50), nullable=False)
    content = db.Column(db.Text, nullable=False)
    is_critic_response = db.Column(db.Boolean, default=False)
    original_message_id = db.Column(db.Integer, db.ForeignKey('message.id'))
    session_id = db.Column(db.String(100), nullable=True, index=True)
    user_id = db.Column(db.String(100), db.ForeignKey('user.id'))
    
    def to_dict(self):
        return {
            'id': self.id,
            'timestamp': self.timestamp.isoformat(),
            'sender_id': self.sender_id,
            'sender_type': self.sender_type,
            'content': self.content,
            'is_critic_response': self.is_critic_response,
            'session_id': self.session_id
        }

class SystemConfig(db.Model):
    key = db.Column(db.String(100), primary_key=True)
    value = db.Column(db.Text, nullable=False)
    updated_at = db.Column(db.DateTime, default=db.func.current_timestamp())

