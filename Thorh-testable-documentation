def mock_critic_response(original_content, all_responses):
    """Generate enhanced mock critic evaluation with scoring"""
    num_responses = len(all_responses)
    scores = {f"Assistant {i+1}": random.randint(60, 95) for i in range(num_responses)}
    
    critic_templates = [
        f"Evaluated {num_responses} responses to '{original_content[:30]}...'. Scores: {json.dumps(scores)}. The responses vary in depth, with some offering technical insights while others focus on practical applications.",
        f"After analyzing {num_responses} responses, here's the breakdown: {json.dumps(scores)}. Each assistant approached the query '{original_content[:40]}...' differently, with varying levels of specificity.",
        f"Critic review of {num_responses} responses to '{original_content[:50]}...': {json.dumps(scores)}. Notable differences in clarity and relevance observed."
    ]
    
    return random.choice(critic_templates)

