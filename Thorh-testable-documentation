@app.route('/')
def index():
    """Main chat interface"""
    try:
        assistants = Assistant.query.all()
        recent_messages = Message.query.filter_by(user_id=current_user.id if current_user.is_authenticated else None)\
                                     .order_by(Message.timestamp.desc()).limit(50).all()
        recent_messages.reverse()
        
        return render_template('index.html', 
                             assistants=[a.to_dict() for a in assistants],
                             chat_history=[m.to_dict() for m in recent_messages])
    except Exception as e:
        logger.error(f"Error loading index: {str(e)}", extra=add_request_id())
        return render_template('index.html', assistants=[], chat_history=[], error=str(e))

@app.route('/add_assistant', methods=['POST'])
@login_required
@limiter.limit("10 per hour")
def add_assistant():
    """Add new AI assistant"""
    try:
        data = request.json
        assistant_type = data['type']
        custom_name = data.get('name', '')
        is_critic = data.get('is_critic', False)
        
        assistant_id = f"{assistant_type}_{uuid.uuid4().hex[:8]}"
        model = f"mock-{assistant_type}-model"  # Mock model, as per your API plan
        
        existing = Assistant.query.filter_by(type=assistant_type, is_critic=is_critic).first()
        if existing and not custom_name:
            return jsonify({
                'status': 'error', 
                'message': f'{assistant_type} {"critic" if is_critic else "assistant"} already exists'
            }), 400
        
        assistant = Assistant(
            id=assistant_id,
            type=assistant_type,
            name=custom_name or f"{assistant_type.title()} {'Critic' if is_critic else 'Assistant'}",
            model=model,
            active=True,
            is_critic=is_critic
        )
        
        db.session.add(assistant)
        db.session.commit()
        
        logger.info(f"Added assistant: {assistant_id} ({assistant_type})", extra=add_request_id())
        return jsonify({
            'status': 'success', 
            'message': f'🎯 {assistant.name} has joined the Helix and is ready for action!',
            'assistant': assistant.to_dict()
        })
        
    except Exception as e:
        logger.error(f"Error adding assistant: {str(e)}", extra=add_request_id())
        db.session.rollback()
        return jsonify({'status': 'error', 'message': str(e)}), 500

@app.route('/toggle_assistant/<assistant_id>')
@login_required
def toggle_assistant(assistant_id):
    """Toggle assistant active status"""
    try:
        assistant = Assistant.query.get(assistant_id)
        if not assistant:
            return jsonify({'status': 'error', 'message': 'Assistant not found'}), 404
        
        assistant.active = not assistant.active
        db.session.commit()
        
        status = "activated" if assistant.active else "deactivated"
        logger.info(f"Toggled assistant {assistant_id} to {status}", extra=add_request_id())
        return jsonify({
            'status': 'success', 
            'message': f'✅ {assistant.name} has been {status}',
            'active': assistant.active
        })
        
    except Exception as e:
        logger.error(f"Error toggling assistant {assistant_id}: {str(e)}", extra=add_request_id())
        return jsonify({'status': 'error', 'message': str(e)}), 500

@app.route('/send_message', methods=['POST'])
@login_required
@limiter.limit("50 per hour")
async def send_message():
    """Process message through multiple AI assistants with critic evaluation"""
    try:
        data = request.json
        user_content = data['message']
        session_id = data.get('session_id', str(uuid.uuid4()))
        
        if not user_content.strip():
            return jsonify({'status': 'error', 'message': 'Message cannot be empty'}), 400
        
        # Validate session
        max_messages = int(get_system_config('max_messages_per_session'))
        session_messages = Message.query.filter_by(session_id=session_id, user_id=current_user.id).count()
        if session_messages >= max_messages:
            return jsonify({'status': 'error', 'message': 'Session message limit reached'}), 400
        
        # Store user message
        user_message = Message(
            sender_id='user',
            sender_type='user',
            content=user_content,
            session_id=session_id,
            user_id=current_user.id
        )
        db.session.add(user_message)
        db.session.commit()
        
        # Get conversation context
        max_context = int(get_system_config('max_context_length'))
        context_messages = Message.query.filter_by(session_id=session_id, user_id=current_user.id)\
                                      .order_by(Message.timestamp)\
                                      .limit(max_context).all()
        
        active_assistants = Assistant.query.filter_by(active=True, is_critic=False).all()
        critic_assistant = Assistant.query.filter_by(active=True, is_critic=True).first()
        
        if not active_assistants:
            return jsonify({
                'status': 'error', 
                'message': 'No active assistants available. Please add and activate at least one assistant.'
            }), 400
        
        responses_for_frontend = []
        llm_responses = {}
        
        # Process assistants asynchronously
        async def process_assistant(assistant):
            try:
                response_text = mock_llm_response(
                    assistant.type, 
                    assistant.model, 
                    user_content,
                    len(context_messages)
                )
                
                llm_message = Message(
                    sender_id=assistant.id,
                    sender_type=assistant.type,
                    content=response_text,
                    session_id=session_id,
                    user_id=current_user.id
                )
                db.session.add(llm_message)
                
                logger.info(f"Response generated by {assistant.name}", extra=add_request_id())
                return assistant.id, response_text, llm_message.to_dict()
            except Exception as e:
                logger.error(f"Error with {assistant.name}: {str(e)}", extra=add_request_id())
                return assistant.id, None, {
                    'sender_id': assistant.id,
                    'sender_type': 'error',
                    'content': f"❌ Error from {assistant.name}: {str(e)}",
                    'timestamp': time.time()
                }
        
        # Run assistant responses concurrently
        tasks = [process_assistant(assistant) for assistant in active_assistants]
        results = await asyncio.gather(*tasks, return_exceptions=True)
        
        for assistant_id, response_text, response_dict in results:
            if response_text:
                llm_responses[assistant_id] = response_text
            responses_for_frontend.append(response_dict)
        
        # Process critic
        if critic_assistant and llm_responses:
            try:
                critic_response = mock_critic_response(user_content, list(llm_responses.values()))
                
                critic_message = Message(
                    sender_id=critic_assistant.id,
                    sender_type=critic_assistant.type,
                    content=critic_response,
                    is_critic_response=True,
                    session_id=session_id,
                    user_id=current_user.id
                )
                db.session.add(critic_message)
                responses_for_frontend.append(critic_message.to_dict())
                
                logger.info(f"Critic evaluation completed by {critic_assistant.name}", extra=add_request_id())
                
            except Exception as e:
                logger.error(f"Error with critic {critic_assistant.name}: {str(e)}", extra=add_request_id())
        
        db.session.commit()
        
        # Cleanup old sessions periodically
        if random.random() < 0.1:  # 10% chance to trigger cleanup
            cleanup_old_sessions()
        
        return jsonify({
            'status': 'success',
            'messages': responses_for_frontend,
            'session_id': session_id,
            'total_responses': len(responses_for_frontend)
        })
        
    except Exception as e:
        logger.error(f"Error processing message: {str(e)}", extra=add_request_id())
        db.session.rollback()
        return jsonify({'status': 'error', 'message': str(e)}), 500

@app.route('/clear_chat', methods=['POST'])
@login_required
def clear_chat():
    """Clear chat history for the current user with confirmation"""
    try:
        data = request.json
        confirm = data.get('confirm', False)
        if not confirm:
            return jsonify({'status': 'error', 'message': 'Confirmation required to clear chat history'}), 400
        
        Message.query.filter_by(user_id=current_user.id).delete()
        db.session.commit()
        logger.info(f"Chat history cleared for user {current_user.id}", extra=add_request_id())
        return jsonify({'status': 'success', 'message': 'Chat history cleared'})
    except Exception as e:
        logger.error(f"Error clearing chat: {str(e)}", extra=add_request_id())
        return jsonify({'status': 'error', 'message': str(e)}), 500

@app.route('/health')
def health_check():
    """System health check with detailed metrics"""
    try:
        db.session.execute('SELECT 1')
        
        assistant_count = Assistant.query.count()
        active_count = Assistant.query.filter_by(active=True).count()
        message_count = Message.query.count()
        session_count = db.session.query(Message.session_id).distinct().count()
        db_size = db.engine.execute("SELECT pg_database_size(current_database())").scalar() if 'postgresql' in database_url else 0
        
        return jsonify({
            'status': 'healthy',
            'timestamp': time.time(),
            'database': 'connected',
            'assistants': {
                'total': assistant_count,
                'active': active_count
            },
            'messages': message_count,
            'sessions': session_count,
            'db_size_bytes': db_size,
            'version': '1.1'
        })
    except Exception as e:
        logger.error(f"Health check failed: {str(e)}", extra=add_request_id())
        return jsonify({'status': 'unhealthy', 'error': str(e)}), 503

