# System configurations
DEFAULT_CONFIGS = {
    'max_context_length': '20',
    'session_timeout_hours': '24',
    'max_messages_per_session': '1000'
}

def init_db():
    """Initialize database tables and default configs"""
    with app.app_context():
        db.create_all()
        
        # Initialize default configurations
        for key, value in DEFAULT_CONFIGS.items():
            if not SystemConfig.query.get(key):
                db.session.add(SystemConfig(key=key, value=value))
        db.session.commit()
        logger.info("Database and configurations initialized")

def get_system_config(key):
    """Retrieve system configuration value"""
    config = SystemConfig.query.get(key)
    return config.value if config else DEFAULT_CONFIGS.get(key)

def cleanup_old_sessions():
    """Remove sessions older than configured timeout"""
    timeout_hours = int(get_system_config('session_timeout_hours'))
    cutoff = datetime.utcnow() - timedelta(hours=timeout_hours)
    old_sessions = Message.query.filter(Message.timestamp < cutoff).distinct(Message.session_id).all()
    for session in old_sessions:
        Message.query.filter_by(session_id=session.session_id).delete()
    db.session.commit()
    logger.info(f"Cleaned up {len(old_sessions)} old sessions")

